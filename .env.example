# Server-side only — read by Expo Router API routes (src/app/api/**). Never prefix with EXPO_PUBLIC_.
ANTHROPIC_API_KEY=
# https://fdc.nal.usda.gov/api-key-signup — Open Food Facts needs no key
USDA_API_KEY=

# Optional, client-visible (it is bundled into the app — never put a secret here).
# Absolute origin of the server that hosts the /api routes. Leave unset in development:
# the app derives the Metro host automatically. Set it for a deployed API,
# e.g. EXPO_PUBLIC_API_URL=https://my-app.example.com
EXPO_PUBLIC_API_URL=
